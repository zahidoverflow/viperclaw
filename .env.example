# =============================================================================
# ViperClaw Environment Configuration Template (.env.example)
# Copy to `.env` for local overrides. `.env` and `.env.*` are git-ignored.
# Never commit real credentials, session cookies, or private keys.
# =============================================================================

# Default SQLite Stigmergic Assessment Graph path
VIPERCLAW_GRAPH_DB=.viperclaw/graph.db

# Default HTTP request timeout in seconds
VIPERCLAW_TIMEOUT=8.0

# Optional Out-of-Band (OOB) callback listener base URL
VIPERCLAW_OOB_CALLBACK=http://127.0.0.1:9999
