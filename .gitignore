# -----------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# 3. Virtual Environments
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

